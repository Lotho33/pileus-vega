{
  "plugins": [
    "@typescript-eslint",
    "@amazon-devices/eslint-plugin-kepler"
  ],
  "extends": [
    "@react-native",
    "eslint:recommended",
    "plugin:@amazon-devices/eslint-plugin-kepler/kepler"
  ],
  "overrides": [
    {
      "files": [
        "**/*.ts",
        "**/*.tsx"
      ],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "project": "./tsconfig.json"
      }
    },
    {
      "files": [
        "package.json",
        "kepler-compatibility.json"
      ],
      "parser": "jsonc-eslint-parser"
    }
  ],
  "ignorePatterns": [
    "src/vendor/**",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "package-lock.json",
    "src/gen/**",
    "src/assets/branding.ts"
  ],
  "globals": {
    "globalThis": "readonly",
    "AbortSignal": "readonly",
    "AbortController": "readonly"
  },
  "rules": {
    "no-bitwise": "off"
  }
}
